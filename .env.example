# ---- MongoDB Atlas ----
# SRV connection string from your Atlas cluster (Database > Connect > Drivers).
# Include the db name in the path, e.g. .../tatkal?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/tatkal?retryWrites=true&w=majority

# ---- Upstash Redis ----
# Use the rediss:// (TLS) URL from the Upstash console. TLS is required.
# Format: rediss://default:PASSWORD@region-name.upstash.io:PORT
REDIS_URL=rediss://default:PASSWORD@your-endpoint.upstash.io:6379

# ---- Server ----
PORT=4000

# Origin of the Vite client (for CORS + Socket.io). Comma-separate for multiple.
CLIENT_URL=http://localhost:5173
