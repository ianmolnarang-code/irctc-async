# ---- MongoDB Atlas (only required service) ----
# SRV connection string from your Atlas cluster (Database > Connect > Drivers).
# Include the db name in the path, e.g. .../tatkal?retryWrites=true&w=majority
# On Vercel, set this as an Environment Variable (do NOT commit real values).
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/tatkal?retryWrites=true&w=majority

# ---- Server (local dev only) ----
PORT=4000

# Origin of the client for CORS. Comma-separate for multiple; use * to allow all.
CLIENT_URL=http://localhost:5173
